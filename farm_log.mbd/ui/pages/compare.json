{
  "type": "page",
  "metadata": {
    "title": "Against other years"
  },
  "onInit": {
    "type": "tool",
    "tool": "log.compare",
    "params": {}
  },
  "state": {
    "initial": {
      "crop": "",
      "season": [],
      "seasonCount": 0,
      "spans": [],
      "spanCount": 0,
      "avgDays": 0,
      "today": "",
      "compare": "",
      "logRule": "",
      "notice": "",
      "compareLine": ""
    }
  },
  "content": {
    "type": "container",
    "decoration": {
      "color": "{{theme.color.surfaceContainerHighest}}"
    },
    "child": {
      "type": "linear",
      "direction": "vertical",
      "children": [
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 20,
            "bottom": 16
          },
          "decoration": {
            "color": "{{theme.color.surface}}",
            "border": {
              "bottom": true,
              "color": "{{theme.color.outline}}",
              "width": 1
            }
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "PLOT A · {{crop}}",
                    "style": {
                      "fontSize": 12,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 2.0
                    }
                  },
                  {
                    "type": "text",
                    "content": "Transplant to first flower",
                    "style": {
                      "fontSize": 21,
                      "color": "{{theme.color.onSurface}}",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "gap": 4
              },
              {
                "type": "spacer"
              },
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "AVERAGE",
                    "style": {
                      "fontSize": 11,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{avgDays}} d",
                    "style": {
                      "fontSize": 26,
                      "color": "{{theme.color.onSurface}}",
                      "fontFamily": "JetBrainsMono"
                    }
                  }
                ],
                "gap": 4,
                "crossAxisAlignment": "end"
              }
            ]
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 10,
            "bottom": 4
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "button",
                "label": "← This season",
                "variant": "outlined",
                "onTap": {
                  "type": "navigation",
                  "action": "pop"
                }
              }
            ]
          }
        },
        {
          "type": "expanded",
          "child": {
            "type": "container",
            "padding": {
              "left": 22,
              "right": 22,
              "top": 16,
              "bottom": 8
            },
            "child": {
              "type": "container",
              "padding": {
                "all": 18
              },
              "decoration": {
                "color": "{{theme.color.surface}}",
                "borderRadius": 14,
                "border": {
                  "color": "{{theme.color.outline}}",
                  "width": 1
                }
              },
              "child": {
                "type": "list",
                "items": "{{spans}}",
                "shrinkWrap": true,
                "itemSpacing": 10,
                "emptyMessage": "Not enough seasons written down to compare",
                "itemTemplate": {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "container",
                      "width": 60,
                      "child": {
                        "type": "text",
                        "content": "{{item.year}}",
                        "textAlign": "start",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 15,
                          "color": "{{theme.color.primary}}",
                          "textAlign": "start",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerStart"
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "text",
                        "content": "{{item.transplant}} → {{item.firstFlower}}",
                        "style": {
                          "fontSize": 14,
                          "color": "{{theme.color.onSurface}}",
                          "fontFamily": "JetBrainsMono"
                        }
                      }
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "container",
                      "width": 60,
                      "child": {
                        "type": "text",
                        "content": "{{item.days}} d",
                        "textAlign": "end",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 15,
                          "color": "{{theme.color.onSurface}}",
                          "textAlign": "end",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerEnd"
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "container",
                      "width": 200,
                      "child": {
                        "type": "text",
                        "content": "{{item.note}}",
                        "textAlign": "end",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 13,
                          "color": "{{theme.color.onSurfaceVariant}}",
                          "textAlign": "end",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerEnd"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 0,
            "bottom": 8
          },
          "child": {
            "type": "container",
            "padding": {
              "all": 18
            },
            "decoration": {
              "color": "{{theme.color.surface}}",
              "borderRadius": 14,
              "border": {
                "color": "{{theme.color.outline}}",
                "width": 1
              }
            },
            "child": {
              "type": "linear",
              "direction": "horizontal",
              "crossAxisAlignment": "center",
              "children": [
                {
                  "type": "text",
                  "content": "THIS SEASON",
                  "style": {
                    "fontSize": 11,
                    "color": "{{theme.color.onSurfaceVariant}}",
                    "letterSpacing": 1.6
                  }
                },
                {
                  "type": "spacer"
                },
                {
                  "type": "text",
                  "content": "{{compareLine}}",
                  "style": {
                    "fontSize": 14,
                    "color": "{{theme.color.onSurface}}"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 22,
            "right": 22,
            "top": 4,
            "bottom": 18
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "content": "{{logRule}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.onSurfaceVariant}}"
                }
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "content": "{{notice}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.primary}}"
                }
              }
            ]
          }
        }
      ],
      "crossAxisAlignment": "stretch"
    }
  }
}
